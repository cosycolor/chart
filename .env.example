# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Tistory API Settings (https://www.tistory.com/guide/api/manage/register)
# 티스토리 블로그명 (예: myblog.tistory.com 이면 myblog)
TISTORY_BLOG_NAME=your_blog_name_here
# 티스토리 OAuth2 Access Token
TISTORY_ACCESS_TOKEN=your_tistory_access_token_here
# 포스팅할 카테고리 ID (선택사항, 0이면 기본 카테고리)
TISTORY_CATEGORY_ID=0
# 글 공개 여부 (0: 비공개, 1: 보호, 3: 발행[기본])
TISTORY_VISIBILITY=3

# 네이버 뉴스 검색 API (선택사항: 공식 오픈API 키 사용 시 더욱 안정적, 없어도 크롤링으로 기본 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
