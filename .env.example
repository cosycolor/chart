# Google Gemini API Key (무료 발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# [추천] 이메일 발송 설정 (네이버 메일 기준)
# 1. 네이버 로그인 -> 환경설정 -> POP3/IMAP 설정 -> 'POP3/SMTP 사용' [사용함] 체크
# 2. 2차 인증 사용 시: 네이버 내정보 -> 보안설정 -> 2단계 인증 -> '애플리케이션 비밀번호' 생성 후 입력
EMAIL_SENDER=your_email@naver.com
EMAIL_PASSWORD=your_naver_password_or_app_password
EMAIL_RECEIVER=your_email@naver.com
SMTP_SERVER=smtp.naver.com
SMTP_PORT=465

# 네이버 뉴스 검색 API (선택사항: 없어도 웹 스크래핑으로 자동 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
